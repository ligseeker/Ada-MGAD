# Ignore large local datasets, but keep the tiny artifact smoke-test sample.
data/*
!data/examples/
data/examples/*
!data/examples/msds_tiny/
data/examples/msds_tiny/*
!data/examples/msds_tiny/pre/
!data/examples/msds_tiny/save/
data/examples/msds_tiny/pre/*
data/examples/msds_tiny/save/*
!data/examples/msds_tiny/pre/trace_path.pkl
!data/examples/msds_tiny/save/dataset.pkl
result/

# Formal GAIA experiment outputs are local by default.  Every run keeps its own
# directory; only the same lightweight analysis records are versioned for any
# run.  This avoids hard-coding a single timestamped run directory.
experiments/*
!experiments/p5/
experiments/p5/*
!experiments/p5/gaia_v2/
!experiments/p5/gaia_v2/*/
experiments/p5/gaia_v2/*/*

# Root-level provenance and report records.
!experiments/p5/gaia_v2/*/final_report.md
!experiments/p5/gaia_v2/*/input_manifest.json
!experiments/p5/gaia_v2/*/resolved_config.json
!experiments/p5/gaia_v2/*/run_manifest.json
!experiments/p5/gaia_v2/*/run_state.json

# Ada-MGAD aggregate analysis records.  All row-level Train/Test prediction
# CSVs remain local; their aggregate metrics and epoch history are tracked.
!experiments/p5/gaia_v2/*/ad/
experiments/p5/gaia_v2/*/ad/*
!experiments/p5/gaia_v2/*/ad/ad_training_summary.json
!experiments/p5/gaia_v2/*/ad/reconstruction_calibration.json

# Event-level aggregate metrics.  Event predictions and matching tables remain
# local because they are row-level diagnostic exports.
!experiments/p5/gaia_v2/*/events/
experiments/p5/gaia_v2/*/events/*
!experiments/p5/gaia_v2/*/events/event_detection_metrics.json

# RCA metrics, model-fit metadata and layer comparisons.  Ranked prediction
# CSVs remain local and can be regenerated or inspected from the run directory.
!experiments/p5/gaia_v2/*/rca/
experiments/p5/gaia_v2/*/rca/*
!experiments/p5/gaia_v2/*/rca/conditional_logit.json
!experiments/p5/gaia_v2/*/rca/e2e_diagnosis_metrics.json
!experiments/p5/gaia_v2/*/rca/e2e_layered_report.json
!experiments/p5/gaia_v2/*/rca/rca_metrics.json
!experiments/p5/gaia_v2/*/rca/rca_train_manifest.json

# Lightweight detected-case health/registry records; feature arrays and shards
# are intentionally not versioned.
!experiments/p5/gaia_v2/*/rca/detected/
experiments/p5/gaia_v2/*/rca/detected/*
!experiments/p5/gaia_v2/*/rca/detected/rca_case_registry_detected_purged.csv
!experiments/p5/gaia_v2/*/rca/detected/rca_feature_health.json
!experiments/p5/gaia_v2/*/rca/detected/rca_feature_manifest.json

# Generated shared GAIA V2 metadata/raw-index outputs stay local.  The
# repository already contains the committed historical protocol artifacts.
artifacts/p5/v3_preprocessing_v2/
artifacts/p5/v3/rca/
artifacts/p5/v3/rca_gt_features/

.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/

__pycache__/
*.pyc

*.log
.env

# P6-B0 score decomposition audit outputs.  The P6 driver is forbidden from
# writing into the formal P5 run, so only the lightweight aggregate records are
# versioned; row-level prediction, matching, and RCA feature exports stay local.
experiments/*
!experiments/p6/
experiments/p6/*
!experiments/p6/score_decomposition/
experiments/p6/score_decomposition/*
!experiments/p6/score_decomposition/*.json
!experiments/p6/score_decomposition/*.md
!experiments/p6/score_decomposition/common_cases.csv
!experiments/p6/score_decomposition/classification/
!experiments/p6/score_decomposition/fused/
!experiments/p6/score_decomposition/reconstruction/
!experiments/p6/score_decomposition/rca/
experiments/p6/score_decomposition/classification/*
experiments/p6/score_decomposition/fused/*
experiments/p6/score_decomposition/reconstruction/*
experiments/p6/score_decomposition/rca/*
!experiments/p6/score_decomposition/*/threshold.json
!experiments/p6/score_decomposition/*/event_metrics.json
!experiments/p6/score_decomposition/*/localization_metrics.json
!experiments/p6/score_decomposition/*/rca_metrics.json
!experiments/p6/score_decomposition/*/diagnosis_metrics.json
!experiments/p6/score_decomposition/rca/rca_feature_manifest.json
!experiments/p6/score_decomposition/rca/rca_feature_health.json
